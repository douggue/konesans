# Public keys. They are built into the apps (anyone can read them from an APK), so they are not secrets.
# They only allow opening a session (SERVER_KEY) or reading published content (HTTP_KEY); admin power comes from
# the admin account's email + password, which live only on the server (/opt/konesans/.env).
SERVER_KEY=konesans-sk-nY9_5rth9pUY
HTTP_KEY=konesans-hk-se6HZd0260kH
# Google sign-in (optional, docs/GOOGLE-SIGNIN.md): the Web client ID(s) Google ID tokens must be made for, comma-separated.
# Public too (it is in the app). Empty = the server refuses every Google link / login.
GOOGLE_CLIENT_IDS=
