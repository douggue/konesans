{
  "expo": {
    "name": "Konesans",
    "slug": "konesans",
    "version": "0.1.0",
    "scheme": "konesans",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F7FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ht.konesans.app"
    },
    "android": {
      "package": "ht.konesans.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F47B5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": "development"
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F47B5",
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14307D",
            "image": "./assets/splash-logo.png"
          }
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "."
    },
    "owner": "tjeangardys-team",
    "extra": {
      "eas": {
        "projectId": "e6f86514-7040-4ad8-a495-ef8463a684c6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e6f86514-7040-4ad8-a495-ef8463a684c6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
